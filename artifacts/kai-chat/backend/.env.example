# Copie este arquivo para ".env" e preencha. NUNCA publique o .env.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="kai"
# Em produção, coloque o endereço do seu site, ex: "https://seusite.com". Separe vários por vírgula.
CORS_ORIGINS="http://localhost:3000"
# Gere um segredo novo: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="troque-por-um-segredo-grande"
# Chave do Google AI Studio (https://aistudio.google.com/apikey). Crie uma NOVA, não reutilize a antiga.
GEMINI_API_KEY=""
# Modelo do Gemini. Confira no AI Studio qual está liberado na sua conta (ex: gemini-2.5-flash).
GEMINI_MODEL="gemini-3-flash-preview"
DAILY_MSG_LIMIT="50"
MINUTE_MSG_LIMIT="6"
HISTORY_LIMIT="20"
MAX_MSG_CHARS="1000"
